# Site URL (production domain — used for SEO metadata and sitemap)
# NEXT_PUBLIC_SITE_URL=https://aprochhealth.com

# WhatsApp number for booking messages (with or without +91)
NEXT_PUBLIC_WHATSAPP_NUMBER=918921849028

# RCI registration number (shown on psychologist profile when set)
# NEXT_PUBLIC_RCI_NUMBER=RCI/CL/2021/XXXXX

# Social links (defaults are baked into the app; set these to override)
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/aprochhere
# NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/aprochhere/
# NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/share/1Ef38bBwd6/

# Agency footer credit (shown by default; set to false to hide)
# NEXT_PUBLIC_AGENCY_URL=https://kaltrix.live
# NEXT_PUBLIC_SHOW_AGENCY_CREDIT=false

# Email via Resend (required for contact form to work)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=support@aprochhere.com
